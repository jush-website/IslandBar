<Window x:Class="IslandBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IslandBar"
        Width="560" Height="310"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        ShowActivated="False"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft JhengHei UI"
        Foreground="White">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <SolidColorBrush x:Key="Accent" Color="#34D3C0" />
        <SolidColorBrush x:Key="Secondary" Color="#A6FFFFFF" />
        <SolidColorBrush x:Key="Tertiary" Color="#66FFFFFF" />
        <SolidColorBrush x:Key="TileBg" Color="#14FFFFFF" />
        <SolidColorBrush x:Key="TrackBg" Color="#26FFFFFF" />

        <!-- 透明圓角按鈕 -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Tag" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#22FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 方塊按鈕（快速設定） -->
        <Style x:Key="TileButton" TargetType="Button">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Background" Value="{StaticResource TileBg}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.65" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 實心強調按鈕 -->
        <Style x:Key="AccentButton" TargetType="Button">
            <Setter Property="Foreground" Value="#0B1F1C" />
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 分頁切換 -->
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#80FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Margin" Value="2,0,0,0" />
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#14FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 文字小分頁（天氣：預報 / 雷達） -->
        <Style x:Key="PillButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#A6FFFFFF" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="#14FFFFFF" CornerRadius="9" Padding="10,3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#24FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 扁平滑桿 -->
        <Style x:Key="SliderFillButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource Accent}" VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyButton" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="FlatSlider" TargetType="Slider">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Height="22" Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBg}" VerticalAlignment="Center" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillButton}" />
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyButton}" />
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="StatTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource TileBg}" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="10,8,10,9" />
        </Style>
        <Style x:Key="StatLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource Secondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0,0,0" />
        </Style>
        <Style x:Key="StatValue" TargetType="TextBlock">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="150" Height="34"
                Background="#F50D0D0F"
                BorderBrush="Transparent" BorderThickness="0"
                CornerRadius="0,0,18,18"
                ClipToBounds="True"
                MouseEnter="Island_MouseEnter"
                MouseLeave="Island_MouseLeave"
                MouseWheel="Island_MouseWheel"
                PreviewMouseLeftButtonDown="Island_PreviewMouseLeftButtonDown"
                PreviewMouseMove="Island_PreviewMouseMove"
                PreviewMouseLeftButtonUp="Island_PreviewMouseLeftButtonUp"
                LostMouseCapture="Island_LostMouseCapture"
                AllowDrop="True"
                DragEnter="Island_DragEnter"
                DragOver="Island_DragOver"
                DragLeave="Island_DragLeave"
                Drop="Island_Drop">
            <Border.RenderTransform>
                <TranslateTransform x:Name="HideTransform" X="0" Y="0" />
            </Border.RenderTransform>

            <Grid>
                <!-- ================= 收合狀態 ================= -->
                <Grid x:Name="CompactView" Height="34" VerticalAlignment="Top">
                    <!-- 沒有媒體：時鐘 ＋ 額度點點 -->
                    <StackPanel x:Name="CompactIdle" Orientation="Horizontal"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock x:Name="CompactClock" Text="20:14" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="CompactTimer" Text="" FontSize="12" FontWeight="SemiBold"
                                   Foreground="#FFB454" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                        <TextBlock x:Name="CompactEvent" Text="" FontSize="11" FontWeight="SemiBold" Foreground="#7AB8FF"
                                   Margin="10,0,0,0" VerticalAlignment="Center" MaxWidth="120" TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <StackPanel x:Name="IdleDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>

                    <!-- 有媒體：封面（跳動條疊在封面上）＋ 歌名 ＋ 額度點點 -->
                    <StackPanel x:Name="CompactMedia" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Visibility="Collapsed">
                        <Border x:Name="CompactArt" Width="22" Height="22" CornerRadius="6" Background="#26FFFFFF"
                                VerticalAlignment="Center">
                            <Grid>
                                <TextBlock x:Name="CompactArtPlaceholder" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="11" />
                                <Border x:Name="CompactEqScrim" CornerRadius="6" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="False" />
                                <StackPanel x:Name="EqBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Height="12" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Rectangle Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2.5" Height="12" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    </StackPanel>
                            </Grid>
                        </Border>
                        <TextBlock x:Name="CompactTitle" Width="140" Text="" FontSize="12" Margin="10,0,0,0"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Foreground="#E6FFFFFF" />
                        <StackPanel x:Name="MediaDots" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>

                <!-- ================= 側邊收合（左側 / 右側）：直式窄條 ================= -->
                <StackPanel x:Name="SideCompactView" Width="40" HorizontalAlignment="Center" VerticalAlignment="Top"
                            Margin="0,10,0,0" Visibility="Collapsed">
                    <StackPanel x:Name="SideIdle" HorizontalAlignment="Center">
                        <TextBlock x:Name="SideClockH" Text="23" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
                        <TextBlock x:Name="SideClockM" Text="44" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center"
                                   Foreground="{StaticResource Secondary}" />
                    </StackPanel>
                    <Border x:Name="SideArt" Width="26" Height="26" CornerRadius="7" Background="#26FFFFFF" HorizontalAlignment="Center"
                            Visibility="Collapsed">
                        <Grid>
                            <TextBlock x:Name="SideArtPlaceholder" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="12" />
                            <Border x:Name="SideEqScrim" CornerRadius="7" Background="#80000000" Visibility="Collapsed" IsHitTestVisible="False" />
                            <StackPanel x:Name="SideEqBars" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center"
                                            Height="14" Visibility="Collapsed" IsHitTestVisible="False">
                                    <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    <Rectangle Width="2.5" Height="14" RadiusX="1.25" RadiusY="1.25" Fill="{StaticResource Accent}" Margin="0.75,0" RenderTransformOrigin="0.5,1">
                                        <Rectangle.RenderTransform><ScaleTransform ScaleY="0.3" /></Rectangle.RenderTransform>
                                    </Rectangle>
                                    </StackPanel>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="SideTimer" Text="" FontSize="10" FontWeight="SemiBold" Foreground="#FFB454"
                               HorizontalAlignment="Center" Margin="0,8,0,0" Visibility="Collapsed" />
                    <StackPanel x:Name="SideDots" HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>

                <!-- ================= 側邊 HUD：直式音量條 ================= -->
                <Grid x:Name="SideHudView" Width="44" Height="180" HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="34" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="38" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="SideHudValue" Text="50" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Grid Grid.Row="1" Width="5" HorizontalAlignment="Center">
                        <Border CornerRadius="2.5" Background="{StaticResource TrackBg}" />
                        <Border CornerRadius="2.5" Background="White" RenderTransformOrigin="0.5,1">
                            <Border.RenderTransform><ScaleTransform x:Name="SideHudBarScale" ScaleY="0.5" /></Border.RenderTransform>
                        </Border>
                    </Grid>
                    <TextBlock x:Name="SideHudGlyph" Grid.Row="2" Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="14" />
                </Grid>

                <!-- ================= HUD（音量 / 計時結束） ================= -->
                <Grid x:Name="HudView" Height="40" Width="300" VerticalAlignment="Top" HorizontalAlignment="Center"
                      Visibility="Collapsed">
                    <Grid Margin="16,0,16,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="44" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HudGlyph" Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="15" />
                        <Grid x:Name="HudBarHost" Grid.Column="1" Margin="10,0,10,0" VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="2.5" Background="{StaticResource TrackBg}" />
                            <Border x:Name="HudBarFill" Height="5" CornerRadius="2.5" Background="White" RenderTransformOrigin="0,0.5">
                                <Border.RenderTransform><ScaleTransform x:Name="HudBarScale" ScaleX="0.5" /></Border.RenderTransform>
                            </Border>
                        </Grid>
                        <TextBlock x:Name="HudMessage" Grid.Column="1" Grid.ColumnSpan="2" Margin="10,0,0,0" FontSize="13"
                                   FontWeight="SemiBold" VerticalAlignment="Center" Visibility="Collapsed"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="HudValue" Grid.Column="2" Text="50" FontSize="12" FontWeight="SemiBold"
                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!-- ================= 展開狀態 ================= -->
                <Grid x:Name="ExpandedView" Width="448" Height="226" Margin="0,12,0,0"
                      HorizontalAlignment="Center" VerticalAlignment="Top" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- 頂列：日期時間 + 分頁 -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="HeaderTime" Text="20:14" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <TextBlock x:Name="HeaderDate" Text="10月22日 星期四" FontSize="12" Foreground="{StaticResource Secondary}"
                                   Margin="10,1,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="TabMedia" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE8D6;"
                                     ToolTip="音樂" IsChecked="True" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabCalendar" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE787;"
                                     ToolTip="日曆與計時器" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabWeather" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE9CA;"
                                     ToolTip="天氣" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabQuota" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE945;"
                                     ToolTip="AI 額度與系統資源" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabStats" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE9D9;"
                                     ToolTip="系統資訊" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabClip" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE77F;"
                                     ToolTip="剪貼簿歷史" Checked="Tab_Checked" />
                        <RadioButton x:Name="TabQuick" GroupName="Tabs" Style="{StaticResource TabButton}" Content="&#xE713;"
                                     ToolTip="快速設定" Checked="Tab_Checked" />
                    </StackPanel>

                    <!-- 固定顯示的 AI 額度列（可在系統匣關閉） -->
                    <WrapPanel x:Name="QuotaStrip" Grid.Row="2" Margin="0,6,0,0" Visibility="Collapsed" />

                    <!-- == 音樂 == -->
                    <Grid x:Name="PageMedia" Grid.Row="1" Margin="0,10,0,0">
                        <Grid x:Name="MediaContent">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="128" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="MediaArt" Width="124" Height="124" CornerRadius="14" Background="#1FFFFFFF"
                                    HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,8,0,0">
                                <TextBlock x:Name="MediaArtPlaceholder" Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="34"
                                           Foreground="{StaticResource Tertiary}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="16,6,0,0">
                                <TextBlock x:Name="MediaTitle" Text="—" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaArtist" Text="" FontSize="13" Foreground="{StaticResource Secondary}"
                                           Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="MediaSource" Text="" FontSize="11" Foreground="{StaticResource Tertiary}" Margin="0,3,0,0" />

                                <Grid x:Name="MediaProgressHost" Margin="0,16,0,0" Height="10" Background="Transparent" Cursor="Hand"
                                      MouseLeftButtonDown="MediaProgress_MouseDown">
                                    <Border Height="4" CornerRadius="2" Background="{StaticResource TrackBg}" VerticalAlignment="Center" />
                                    <Border Height="4" CornerRadius="2" Background="White" VerticalAlignment="Center" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="MediaProgressScale" ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                                <Grid Margin="0,3,0,0">
                                    <TextBlock x:Name="MediaPos" Text="0:00" FontSize="10" Foreground="{StaticResource Tertiary}" />
                                    <TextBlock x:Name="MediaDur" Text="0:00" FontSize="10" Foreground="{StaticResource Tertiary}" HorizontalAlignment="Right" />
                                </Grid>

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" Click="Prev_Click" ToolTip="上一首">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE892;" FontSize="16" />
                                    </Button>
                                    <Button x:Name="PlayPauseButton" Width="44" Height="44" Margin="14,0" Click="PlayPause_Click"
                                            Cursor="Hand" Focusable="False">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" Background="White" CornerRadius="22">
                                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.7" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                        <TextBlock x:Name="PlayPauseGlyph" Style="{StaticResource Glyph}" Text="&#xE768;" FontSize="17" Foreground="Black" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Width="40" Height="40" Click="Next_Click" ToolTip="下一首">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE893;" FontSize="16" />
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                        <StackPanel x:Name="NoMediaPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D6;" FontSize="30" Foreground="{StaticResource Tertiary}" />
                            <TextBlock Text="目前沒有播放中的媒體" FontSize="13" Foreground="{StaticResource Secondary}" Margin="0,10,0,0"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="打開 Spotify、YouTube 等播放音樂就會出現在這裡" FontSize="11" Foreground="{StaticResource Tertiary}"
                                       Margin="0,4,0,0" HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <!-- == 日曆 + 計時器 == -->
                    <Grid x:Name="PageCalendar" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="246" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:Name="CalMonthText" Text="2026年10月" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="4,0,0,0" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="CalPrev_Click">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76B;" FontSize="10" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="CalToday_Click" ToolTip="回到今天">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE8D1;" FontSize="10" />
                                </Button>
                                <Button Style="{StaticResource IconButton}" Width="24" Height="24" Click="CalNext_Click">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE76C;" FontSize="10" />
                                </Button>
                            </StackPanel>
                            <UniformGrid x:Name="CalGrid" Grid.Row="1" Columns="7" Rows="7" Margin="0,2,0,0" />
                        </Grid>

                        <Border Grid.Column="2" Background="{StaticResource TileBg}" CornerRadius="14" Padding="12,10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Glyph}" Text="&#xE916;" FontSize="12" Foreground="{StaticResource Secondary}" />
                                        <TextBlock x:Name="TimerTitle" Text="計時器" FontSize="11" Foreground="{StaticResource Secondary}" Margin="6,0,0,0" />
                                    </StackPanel>
                                    <Button x:Name="FocusButton" HorizontalAlignment="Right" Style="{StaticResource IconButton}" Height="22" Padding="8,0"
                                            Background="#1FFFFFFF" Click="Focus_Click" ToolTip="專注 25 分鐘＋休息 5 分鐘；專注時暫停通知、動態島變暗">
                                        <TextBlock x:Name="FocusButtonText" Text="專注 25" FontSize="10" />
                                    </Button>
                                </Grid>
                                <TextBlock x:Name="TimerText" Grid.Row="1" Text="00:00" FontSize="36" FontWeight="SemiBold"
                                           FontFamily="Segoe UI Variable Display, Segoe UI"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <UniformGrid Grid.Row="2" Columns="3" Margin="0,0,0,8">
                                    <Button Style="{StaticResource IconButton}" Height="26" Margin="2,0" Background="#14FFFFFF" Click="TimerAdd_Click" Tag="1">
                                        <TextBlock Text="+1 分" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Height="26" Margin="2,0" Background="#14FFFFFF" Click="TimerAdd_Click" Tag="5">
                                        <TextBlock Text="+5 分" FontSize="11" />
                                    </Button>
                                    <Button Style="{StaticResource IconButton}" Height="26" Margin="2,0" Background="#14FFFFFF" Click="TimerAdd_Click" Tag="10">
                                        <TextBlock Text="+10 分" FontSize="11" />
                                    </Button>
                                </UniformGrid>
                                <Grid Grid.Row="3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="8" />
                                        <ColumnDefinition Width="64" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="TimerStartButton" Style="{StaticResource AccentButton}" Click="TimerStart_Click">
                                        <TextBlock x:Name="TimerStartText" Text="開始" FontSize="12" />
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Height="30" Background="#1FFFFFFF" Click="TimerReset_Click">
                                        <TextBlock Text="重設" FontSize="12" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- == 系統資訊 == -->
                    <UniformGrid x:Name="PageStats" Grid.Row="1" Columns="3" Rows="2" Margin="-4,6,-4,-4" Visibility="Collapsed">
                        <!-- CPU -->
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE950;" FontSize="13" Foreground="#FF7A7A" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="CPU" />
                                </StackPanel>
                                <TextBlock x:Name="CpuValue" Style="{StaticResource StatValue}" Text="0%" />
                                <Grid Margin="0,7,0,0" Height="4">
                                    <Border CornerRadius="2" Background="{StaticResource TrackBg}" />
                                    <Border CornerRadius="2" Background="#FF7A7A" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="CpuBar" ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- RAM -->
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE964;" FontSize="13" Foreground="#7AB8FF" />
                                    <TextBlock x:Name="RamLabel" Style="{StaticResource StatLabel}" Text="記憶體" />
                                </StackPanel>
                                <TextBlock x:Name="RamValue" Style="{StaticResource StatValue}" Text="0%" />
                                <Grid Margin="0,7,0,0" Height="4">
                                    <Border CornerRadius="2" Background="{StaticResource TrackBg}" />
                                    <Border CornerRadius="2" Background="#7AB8FF" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="RamBar" ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- 電池 / 磁碟 -->
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="PowerGlyph" Style="{StaticResource Glyph}" Text="&#xEDA2;" FontSize="13" Foreground="#7CE38B" />
                                    <TextBlock x:Name="PowerLabel" Style="{StaticResource StatLabel}" Text="磁碟" />
                                </StackPanel>
                                <TextBlock x:Name="PowerValue" Style="{StaticResource StatValue}" Text="0%" />
                                <Grid Margin="0,7,0,0" Height="4">
                                    <Border CornerRadius="2" Background="{StaticResource TrackBg}" />
                                    <Border CornerRadius="2" Background="#7CE38B" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="PowerBar" ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- 網路 -->
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE774;" FontSize="13" Foreground="#C29BFF" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="網路" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74B;" FontSize="10" Foreground="{StaticResource Secondary}" />
                                    <TextBlock x:Name="NetDown" Text="0 KB/s" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE74A;" FontSize="10" Foreground="{StaticResource Secondary}" />
                                    <TextBlock x:Name="NetUp" Text="0 KB/s" FontSize="13" FontWeight="SemiBold" Margin="5,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <!-- GPU -->
                        <Border Style="{StaticResource StatTile}" x:Name="GpuTile">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE7F4;" FontSize="13" Foreground="#FFB454" />
                                    <TextBlock x:Name="GpuLabel" Style="{StaticResource StatLabel}" Text="GPU" />
                                </StackPanel>
                                <TextBlock x:Name="GpuValue" Style="{StaticResource StatValue}" Text="—" />
                                <Grid Margin="0,7,0,0" Height="4">
                                    <Border CornerRadius="2" Background="{StaticResource TrackBg}" />
                                    <Border CornerRadius="2" Background="#FFB454" RenderTransformOrigin="0,0.5">
                                        <Border.RenderTransform><ScaleTransform x:Name="GpuBar" ScaleX="0" /></Border.RenderTransform>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>
                        <!-- 已開機時間 -->
                        <Border Style="{StaticResource StatTile}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE823;" FontSize="13" Foreground="#64D2FF" />
                                    <TextBlock Style="{StaticResource StatLabel}" Text="已開機" />
                                </StackPanel>
                                <TextBlock x:Name="UptimeValue" Style="{StaticResource StatValue}" Text="—" />
                                <TextBlock x:Name="UptimeSince" Text="" FontSize="11" Foreground="{StaticResource Tertiary}" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- == 天氣 == -->
                    <Grid x:Name="PageWeather" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- 現在天氣 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="WxGlyph" Text="&#x2600;" FontFamily="Segoe UI Symbol" FontSize="30" Foreground="#FFD166"
                                       VerticalAlignment="Center" Margin="2,0,0,0" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock x:Name="WxTemp" Text="--°" FontSize="30" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="WxCity" Text="定位中…" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                                               ToolTip="點一下選擇天氣地區" MouseLeftButtonUp="WeatherTile_Click" TextTrimming="CharacterEllipsis" MaxWidth="150" />
                                    <TextBlock x:Name="WxDesc" Text="載入中…" FontSize="11" Foreground="{StaticResource Secondary}" Margin="0,2,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <RadioButton x:Name="WxModeForecast" GroupName="WxMode" Style="{StaticResource PillButton}" Content="預報"
                                                 IsChecked="True" Checked="WxMode_Checked" />
                                    <RadioButton x:Name="WxModeRadar" GroupName="WxMode" Style="{StaticResource PillButton}" Content="雷達"
                                                 Checked="WxMode_Checked" />
                                </StackPanel>
                                <TextBlock x:Name="WxDetail1" Text="" FontSize="11" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,4,0,0" />
                                <TextBlock x:Name="WxDetail2" Text="" FontSize="11" Foreground="{StaticResource Secondary}" HorizontalAlignment="Right" Margin="0,1,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- 預報：逐時 + 一週 -->
                        <Grid x:Name="WxForecastView" Grid.Row="1" Margin="0,8,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource TileBg}" CornerRadius="12" Padding="4,6">
                                <ScrollViewer x:Name="WxHourScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                              PreviewMouseWheel="WxHourScroll_PreviewMouseWheel">
                                    <StackPanel x:Name="WxHours" Orientation="Horizontal" />
                                </ScrollViewer>
                            </Border>
                            <Border Grid.Row="1" Background="{StaticResource TileBg}" CornerRadius="12" Padding="10,4" Margin="0,6,0,0">
                                <StackPanel x:Name="WxDays" VerticalAlignment="Center" />
                            </Border>
                        </Grid>

                        <!-- 雷達 -->
                        <Grid x:Name="WxRadarView" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                            <Border x:Name="RadarHost" CornerRadius="12" Background="#101114" ClipToBounds="True">
                                <Grid>
                                    <Canvas x:Name="RadarCanvas" ClipToBounds="True" />
                                    <TextBlock x:Name="RadarStatus" Text="載入雷達中…" FontSize="12" Foreground="White" Background="#B0000000" Padding="10,4"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    <Border Background="#B0000000" CornerRadius="9" Padding="6,3,10,3" Margin="8"
                                            HorizontalAlignment="Left" VerticalAlignment="Top">
                                        <StackPanel Orientation="Horizontal">
                                            <Button x:Name="RadarPlay" Style="{StaticResource IconButton}" Width="20" Height="20" Click="RadarPlay_Click" ToolTip="播放 / 暫停">
                                                <TextBlock x:Name="RadarPlayGlyph" Style="{StaticResource Glyph}" Text="&#xE769;" FontSize="11" />
                                            </Button>
                                            <TextBlock x:Name="RadarTime" Text="--:--" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="6,0,0,0" />
                                        </StackPanel>
                                    </Border>
                                    <Button x:Name="CwaRadarButton" Style="{StaticResource AccentButton}" Content="氣象署雷達" Height="26" Width="96"
                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="8" Click="CwaRadar_Click"
                                            ToolTip="開啟中央氣象署雷達回波圖（較清楚）" Visibility="Collapsed" />
                                    <TextBlock Text="RainViewer · © OpenStreetMap · © CARTO" FontSize="9" Foreground="#CC333333" Background="#99FFFFFF" Padding="4,1"
                                               HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,8,4" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- == AI 額度 == -->
                    <Grid x:Name="PageQuota" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <StackPanel x:Name="QuotaList" />
                        </ScrollViewer>
                        <StackPanel x:Name="QuotaEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE945;" FontSize="28" Foreground="{StaticResource Tertiary}" />
                            <TextBlock Text="還沒有額度資料" FontSize="13" Foreground="{StaticResource Secondary}" Margin="0,10,0,0" HorizontalAlignment="Center" />
                            <TextBlock x:Name="QuotaEmptyHint" Text="這台電腦需要安裝並登入 Codex、Claude Code 或 Antigravity" FontSize="11"
                                       Foreground="{StaticResource Tertiary}" Margin="0,4,0,0" HorizontalAlignment="Center" TextWrapping="Wrap"
                                       TextAlignment="Center" MaxWidth="400" />
                        </StackPanel>
                    </Grid>

                    <!-- == 剪貼簿歷史 == -->
                    <Grid x:Name="PageClip" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="24" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="最近複製的內容（點一下再複製）" FontSize="11" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="2,0,0,0" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Height="22" Padding="8,0" Click="ClipClear_Click">
                            <TextBlock Text="清除" FontSize="11" />
                        </Button>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Hidden" Focusable="False">
                            <StackPanel x:Name="ClipList" />
                        </ScrollViewer>
                        <TextBlock x:Name="ClipEmpty" Grid.Row="1" Text="還沒有複製過東西（密碼管理器複製的內容不會被記錄）" FontSize="11"
                                   Foreground="{StaticResource Tertiary}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- == 快速設定 == -->
                    <Grid x:Name="PageQuick" Grid.Row="1" Margin="0,8,0,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="44" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{StaticResource TileBg}" CornerRadius="12" Padding="6,0,14,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="34" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                                <Button Style="{StaticResource IconButton}" Width="32" Height="32" Click="Mute_Click" ToolTip="靜音">
                                    <TextBlock x:Name="VolumeGlyph" Style="{StaticResource Glyph}" Text="&#xE767;" FontSize="14" />
                                </Button>
                                <Slider x:Name="VolumeSlider" Grid.Column="1" Style="{StaticResource FlatSlider}" Minimum="0" Maximum="100"
                                        VerticalAlignment="Center" Margin="8,0,8,0" ValueChanged="VolumeSlider_ValueChanged" />
                                <TextBlock x:Name="VolumeText" Grid.Column="2" Text="0" FontSize="12" FontWeight="SemiBold"
                                           HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <UniformGrid Grid.Row="1" Columns="3" Rows="2" Margin="-4,4,-4,-4">
                            <Button x:Name="DarkModeTile" Style="{StaticResource TileButton}" Click="DarkMode_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE708;" FontSize="17" />
                                    <TextBlock x:Name="DarkModeText" Text="深色模式" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Click="Wifi_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE701;" FontSize="17" />
                                    <TextBlock Text="Wi-Fi" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Click="Bluetooth_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE702;" FontSize="17" />
                                    <TextBlock Text="藍牙" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Click="Screenshot_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE722;" FontSize="17" />
                                    <TextBlock Text="截圖" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Click="Lock_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE72E;" FontSize="17" />
                                    <TextBlock Text="鎖定" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource TileButton}" Click="Settings_Click">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="17" />
                                    <TextBlock Text="設定" FontSize="11" Margin="0,6,0,0" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                    </Grid>
                </Grid>

                <!-- ================= 格式轉換輪盤（拖檔案進來時） ================= -->
                <Grid x:Name="WheelView" Width="440" Height="300" HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed">
                    <Canvas x:Name="WheelCanvas" Width="440" Height="300" Background="Transparent"
                            MouseMove="WheelCanvas_MouseMove" MouseLeftButtonUp="WheelCanvas_MouseLeftButtonUp" />
                </Grid>

                <!-- 麥克風 / 鏡頭使用中（像 iPhone 的橘點、綠點） -->
                <StackPanel x:Name="PrivacyDots" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0,5,9,0" Background="Transparent">
                    <Ellipse x:Name="MicDot" Width="6" Height="6" Fill="#FF9F0A" Margin="2,0" Visibility="Collapsed" />
                    <Ellipse x:Name="CamDot" Width="6" Height="6" Fill="#30D158" Margin="2,0" Visibility="Collapsed" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
